# =============================================================================
# UNICEF x RBC Borealis AI -- Jamaica Child Deprivation Pipeline
# .gitignore
# =============================================================================

# -----------------------------------------------------------------------------
# Python
# -----------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
.Python
pip-log.txt
pip-delete-this-directory.txt

# Virtual environments
.venv/
venv/
env/
ENV/
.env

# Distribution / packaging
build/
dist/
*.egg-info/
*.egg
.eggs/
wheels/

# Installer logs
*.log

# Unit test / coverage
.pytest_cache/
.coverage
htmlcov/
.tox/
nosetests.xml
coverage.xml
*.cover

# Type checkers
.mypy_cache/
.dmypy.json
dmypy.json
.pytype/

# -----------------------------------------------------------------------------
# Jupyter Notebooks
# -----------------------------------------------------------------------------
.ipynb_checkpoints/
*/.ipynb_checkpoints/*

# -----------------------------------------------------------------------------
# Large / raw geospatial data files
# (keep CSVs and GPKG under version control if small enough)
# -----------------------------------------------------------------------------

# Rasters and large geospatial binary formats
*.tif
*.tiff
*.img
*.vrt
*.nc

# Zip archives (raw downloads)
*.zip

# SPSS microdata files (licensed / confidential — do not commit)
*.sav

# Large Folium HTML maps (full grid embedded — often >100 MB → GitHub GH001).
# Keep *_sample.html and small maps trackable if needed.
Data/outputs/nga/maps/nga_predictions_map.html
Data/outputs/nga/maps/nga_uncertainty_map.html
Data/outputs/nga/maps/nga_comparison_map.html
Data/outputs/nga/maps/nga_dimension_comparison_map.html
Data/outputs/nga/maps/nga_explainability_map.html
Data/outputs/nga/maps/*.geojson

# Large pipeline CSV exports (prefer Parquet in repo/scripts; CSV can exceed GitHub 100 MB cap)
Data/outputs/nga/tables/nga_prediction_breakdown.csv
Data/outputs/nga/tables/nga_predictions.csv

# NBS MPI Stata microdata (restricted / large; now at Data/Nigeria/d1_external/nbs_mpi/survey/)
Nigeria Multidimensional Poverty Index Survey/**/*.dta
Data/Nigeria/d1_external/nbs_mpi/survey/**/*.dta

# Large derived feature files
Data/Nigeria/features/nga_osm_buildings.parquet

# NEMIS bulk school Excel (~21 MB total — re-download with curl; see Data/Nigeria/d1_external/README.md)
Data/Nigeria/d1_external/nemis/*.xlsx

# Extracted raster temp files
/tmp/
temp_raster*/

# Keep the directory stubs so git tracks the folder structure
!data/interim/.gitkeep
!data/outputs/.gitkeep
!data/outputs/tables/.gitkeep
!data/outputs/maps/.gitkeep
!data/outputs/eval/.gitkeep

# -----------------------------------------------------------------------------
# OS / editor artifacts
# -----------------------------------------------------------------------------

# macOS
.DS_Store
.AppleDouble
.LSOverride
Icon?
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# VS Code / Cursor
.vscode/
*.code-workspace

# JetBrains
.idea/
*.iml

# -----------------------------------------------------------------------------
# Secrets / credentials
# -----------------------------------------------------------------------------
.env
.env.*
secrets.yaml
secrets.json
*.pem
*.key

# -----------------------------------------------------------------------------
# Next.js visualization app (visualization/)
# -----------------------------------------------------------------------------

# Node dependencies
visualization/node_modules/
visualization/.pnp
visualization/.pnp.js

# Next.js build output
visualization/.next/
visualization/out/

# Next.js cache
visualization/.next/cache/

# Environment files inside visualization
visualization/.env
visualization/.env.*
visualization/.env.local
visualization/.env.development.local
visualization/.env.test.local
visualization/.env.production.local

# Next.js type declarations (auto-generated)
visualization/next-env.d.ts

# npm / yarn / pnpm debug logs
visualization/npm-debug.log*
visualization/yarn-debug.log*
visualization/yarn-error.log*
visualization/.pnpm-debug.log*

# -----------------------------------------------------------------------------
# DHS raw data (licensed — do not commit)
# -----------------------------------------------------------------------------
NGHR7BFL/
NGKR7BFL/
NGGE7BFL/
Data/Nigeria/dhs/

# IIAG source Excel (large; now at Data/Nigeria/d1_external/governance/)
Data/Nigeria/d1_external/governance/2024-IIAG-scores.xlsx

# Docs folder (PDFs, reference material)
docs/*.pdf

# -----------------------------------------------------------------------------
# Misc
# -----------------------------------------------------------------------------
*.bak
*.swp
*.swo
*~
