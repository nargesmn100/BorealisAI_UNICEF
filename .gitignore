# =============================================================================
# UNICEF x RBC Borealis AI -- Jamaica Child Deprivation Pipeline
# .gitignore
# =============================================================================

# -----------------------------------------------------------------------------
# Python
# -----------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
.Python
pip-log.txt
pip-delete-this-directory.txt

# Virtual environments
.venv/
venv/
env/
ENV/
.env

# Distribution / packaging
build/
dist/
*.egg-info/
*.egg
.eggs/
wheels/

# Installer logs
*.log

# Unit test / coverage
.pytest_cache/
.coverage
htmlcov/
.tox/
nosetests.xml
coverage.xml
*.cover

# Type checkers
.mypy_cache/
.dmypy.json
dmypy.json
.pytype/

# -----------------------------------------------------------------------------
# Jupyter Notebooks
# -----------------------------------------------------------------------------
.ipynb_checkpoints/
*/.ipynb_checkpoints/*

# -----------------------------------------------------------------------------
# Large / raw geospatial data files
# (keep CSVs and GPKG under version control if small enough)
# -----------------------------------------------------------------------------

# Rasters
*.tif
*.tiff
*.img
*.vrt
*.nc

# Zip archives (raw downloads)
*.zip

# Large binary data formats
*.h5
*.hdf5

# Specific large files
Data/Geospatial/jam_pop_2030_CN_100m_R2025A_v1.tif
Data/Geospatial/GHS_SMOD_E2030_GLOBE_R2023A_54009_1000_V2_0.zip
Data/Geospatial/cit_017_accessibility_to_cities.zip
Data/Geospatial/access_50k.zip

# Extracted raster temp files
/tmp/
temp_raster*/

# -----------------------------------------------------------------------------
# Intermediate and output data
# (generated by python main.py -- do not commit)
# -----------------------------------------------------------------------------
data/interim/
data/outputs/

# Keep the directory stubs so git tracks the folder structure
!data/interim/.gitkeep
!data/outputs/.gitkeep
!data/outputs/tables/.gitkeep
!data/outputs/maps/.gitkeep
!data/outputs/eval/.gitkeep

# -----------------------------------------------------------------------------
# Parquet / Arrow files
# -----------------------------------------------------------------------------
*.parquet
*.arrow
*.feather

# -----------------------------------------------------------------------------
# OS / editor artifacts
# -----------------------------------------------------------------------------

# macOS
.DS_Store
.AppleDouble
.LSOverride
Icon?
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# VS Code / Cursor
.vscode/
*.code-workspace

# JetBrains
.idea/
*.iml

# -----------------------------------------------------------------------------
# Secrets / credentials
# -----------------------------------------------------------------------------
.env
.env.*
secrets.yaml
secrets.json
*.pem
*.key

# -----------------------------------------------------------------------------
# Misc
# -----------------------------------------------------------------------------
*.bak
*.swp
*.swo
*~
